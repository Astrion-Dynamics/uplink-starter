UPLINK_HOST=https://www.uplinkcms.com
UPLINK_API_KEY=upl_<your_client_api_key_here>
UPLINK_WEBHOOK_SECRET=whsec_<shown once when you add a webhook in Uplink>
# Only when UPLINK_HOST is a protected preview deployment (e.g. https://preview.uplinkcms.com): the Vercel bypass secret. Leave empty for production.
UPLINK_PROTECTION_BYPASS=
